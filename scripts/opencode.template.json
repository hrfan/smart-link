{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true,
    "prune": true
  },
  "provider": {
    "dces-anthropic": {
      "npm": "@ai-sdk/anthropic",
      "name": "神州博海·GATEWAY",
      "options": {
        "baseURL": "{env:DCES_GATEWAY_URL}/anthropic/v1",
        "apiKey": "{env:DCES_API_KEY}"
      },
      "models": {
        "kimi/k3": {
          "name": "Kimi K3",
          "reasoning": true,
          "tool_call": true,
          "attachment": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 1048576,
            "output": 131072
          },
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 8192
            }
          },
          "variants": {
            "max": {
              "options": {
                "thinking": {
                  "type": "enabled",
                  "budgetTokens": 16384
                }
              }
            }
